# Copy to .env (gitignored). Pick ONE auth mode per run with `owl run --auth ...`.

# --auth oauth (default): your Claude subscription, same browser login as /login.
# Generate a 1-year token in YOUR terminal:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# --auth api-key: pay-per-use key from console.anthropic.com. Required for vanilla-bare.
ANTHROPIC_API_KEY=
